DATABASE_URL=postgresql+psycopg://seops:seops@localhost:5432/seops
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=seops_session
SESSION_MAX_AGE_SECONDS=1209600
CORS_ORIGINS=http://localhost:3000

GSC_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# Optional; omit this variable to reuse GSC_SERVICE_ACCOUNT_FILE.
GA4_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
SYNC_LAG_DAYS=3
SYNC_TIMEZONE=UTC
REPORTS_DIR=reports
# Test-only fake mode requires an explicit exported SYNC_FAKE_CLIENT=1 (see README).

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_VIEWER_EMAIL=viewer@example.com
SEED_VIEWER_PASSWORD=
# Separate disposable test database; the test suite creates/drops its own schema.
TEST_DATABASE_URL=postgresql+psycopg://seops:seops@localhost:5432/seops_test

# Optional existing GA4 call event by site slug. No tracking is installed by SEOPs.
GA4_CALL_CLICK_EVENTS={}
# Optional five-site portfolio selection (only accessible sites are returned).
PORTFOLIO_SITE_SLUGS=[]

# AI insights (OpenRouter, OpenAI-compatible). Leave the key empty to disable AI.
OPENROUTER_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free
# LLM_MAX_TOKENS=4000
# LLM_TIMEOUT_SECONDS=120
# LLM_DAILY_REQUEST_BUDGET=45
